    "from dotenv import load_dotenv\n",
    "from langchain_google_genai import ChatGoogleGenerativeAI\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "\n",
    "llm= ChatGoogleGenerativeAI(model='gemini-3.1-flash-lite')\n",
    "res = llm.invoke(\"Where is india\")\n",
    "print(res.content)"
