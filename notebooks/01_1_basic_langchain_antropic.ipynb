    "#### Example with Antropic"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9be64513",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The largest number in the list [3, 4, 5, 6, 3, 9, 11, 5] is **11**.\n"
     ]
    }
   ],
   "source": [
    "from dotenv import load_dotenv\n",
    "from langchain_anthropic import ChatAnthropic\n",
    "\n",
    "load_dotenv()\n",
    "\n",
    "\n",
    "llm   = ChatAnthropic(model=\"claude-haiku-5-5\")\n",
    "res = llm.invoke(\"find largest number in list [3,4,5,6,3,9,11,5]\")\n",
    "print(res.content)\n"
   ]
  },
